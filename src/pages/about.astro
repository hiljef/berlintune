---
const pageTitle = "about berlintune";

const identity = {
  hj: "hilary jeffery",
  ep: "eleni poulou",
  city: "berlin",
  act1: "music",
  prod: ["songs", "improvisations", "texts", "collages", "radio plays"],
};

const form = ["records", "tapes", "cds", "zines", "books", "digital", "websites"];;

const collab = true;
const contact = true;
const free = false;
const number = 3;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a href="/">home</a>
		<a href="/about/">about</a>
		<a href="/news/">news</a>
		
		<h1>{pageTitle}</h1>
                <p>composition studio in berlin</p>
                
                <p>who we are</p>
		<ul>
 		 <li>{identity.hj} + {identity.ep}</li>
 		 <li>we live and work in {identity.city} where we compose and record {identity.act1}</li>
  		{identity.prod.length >= 5 &&
    		<li>our productions include: {identity.prod[0]}, {identity.prod[1]}, {identity.prod[2]}, {identity.prod[3]} and 			{identity.prod[4]}</li>
  }
		</ul>
		<p>we publish music in the following formats</p>
		<ul>
 		 {form.map((form) => <li>{form}</li>)}
		</ul>
		
		{collab && <p>we are open for creative collaborations</p>}
		{contact && <p>we will be glad to hear from you</p>}
		{free && <p>we will work for free</p>}
		{number === 3 ? <p>the studio is big enough for 3 people</p> : <p>the studio has no space</p>}		
	</body>
</html>
