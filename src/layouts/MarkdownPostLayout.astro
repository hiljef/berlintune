---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={frontmatter.title}>
<meta charset="utf-8" />
<hr>
<p><em>{frontmatter.pubDate.toString().slice(0,10)}</em></p>
<p><b>{frontmatter.description}</b> by <b>{frontmatter.author}</b></p>
<img src={frontmatter.image.url} style="width: 50%; height: auto;" alt={frontmatter.image.alt} />
<hr>
<slot />
</BaseLayout>
